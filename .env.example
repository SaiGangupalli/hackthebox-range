DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"
AUTH_SECRET="run: npx auth secret   (or: openssl rand -base64 32)"

# Optional event mode (ISO 8601 with timezone). Leave unset for always-open practice.
# EVENT_START="2026-11-07T09:00:00+05:30"   flags accepted from here
# EVENT_END="2026-11-07T17:00:00+05:30"     submissions close, final board shown
# EVENT_FREEZE="2026-11-07T16:00:00+05:30"  scoreboard freezes for the last hour

# Optional: max players per team (default 4).
# TEAM_MAX="4"

# Optional: minutes a player waits after failing a certification exam (default 30).
# CERT_RETRY_MINUTES="30"

# Organizers: comma-separated handles that can open /admin (announcements, hide
# challenges, ban players, reset passwords). Unset = nobody.
# ADMIN_HANDLES="your_handle"

# Optional rate-limit tuning (in-memory, per server process). Per-IP limits are
# generous because event players often share one venue IP.
# RATE_LOGIN_FAILS_PER_HANDLE="10"   failed sign-ins per handle per 15 min
# RATE_LOGIN_PER_IP="150"            sign-in attempts per IP per 15 min
# RATE_REGISTER_PER_IP="40"          sign-ups per IP per hour

# AI tutor & practice-question generation (server-side only — never exposed to browsers).
# ANTHROPIC_API_KEY="sk-ant-..."     Claude (claude-opus-5-5) powers every AI feature
# X_GROK_API_KEY="xai-..."           optional backup, used only if a Claude request fails
# GROK_MODEL="grok-4.7"              optional backup model override
# AI_TUTOR_PER_HOUR="30"             tutor messages per signed-in player per hour
# AI_QUESTIONS_PER_HOUR="6"          generated quiz rounds per player per hour
