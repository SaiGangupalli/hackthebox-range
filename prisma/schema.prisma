// H@ck1h3B0x Range — scoreboard schema.
// Shared Neon DB: everything lives in the `hhb` Postgres schema (tables keep the
// `hhb_` prefix too). `schemas` scopes Prisma to it, so diffs can never touch
// other apps' tables. Change it via `npm run db:diff` / `db:apply`. See README.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["hhb"]
}

model User {
  id        String   @id @default(cuid())
  handle    String   @unique
  password  String // scrypt: "scrypt$<saltHex>$<hashHex>"
  createdAt DateTime @default(now())
  solves    Solve[]

  @@map("hhb_user")
  @@schema("hhb")
}

model Solve {
  id          String   @id @default(cuid())
  userId      String
  challengeId String
  points      Int
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, challengeId])
  @@index([userId])
  @@map("hhb_solve")
  @@schema("hhb")
}
