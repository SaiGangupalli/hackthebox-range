{
  "name": "hackthebox-range",
  "version": "0.1.0",
  "private": true,
  "description": "H@ck1h3B0x Range — a defensive-security CTF training hub (9 tracks, OWASP Web & LLM Top 10, cheatsheets, in-browser lab tools).",
  "scripts": {
    "dev": "node scripts/serve.mjs dev",
    "build": "next build",
    "start": "node scripts/serve.mjs start",
    "test": "node --test --experimental-strip-types --no-warnings --import ./tests/support/register.mjs \"tests/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "postinstall": "prisma generate",
    "db:diff": "sh scripts/db.sh diff",
    "db:apply": "sh scripts/db.sh apply",
    "db:backup": "node scripts/backup.mjs",
    "flag-hash": "node scripts/flag-hash.mjs",
    "loadtest": "node scripts/loadtest.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@prisma/client": "^6.19.3",
    "next": "^15.3.0",
    "next-auth": "^5.0.0-beta.32",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^20.17.12",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "prisma": "^6.19.3",
    "typescript": "^5.7.3"
  }
}
